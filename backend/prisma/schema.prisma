generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  firstName  String
  lastName   String
  phone      String?  @unique
  role       UserRole @default(FREELANCER)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs      Job[]
  proposals Proposal[]

  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?

  contractAsClient     Contract[] @relation("ClientContracts")
  contractAsFreelancer Contract[] @relation("FreelancerContracts")
}

enum UserRole {
  FREELANCER
  CLIENT
  ADMIN
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  budget      Float
  status      JobStatus @default(OPEN)

  clientId Int
  client   User @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Proposal {
  id           Int            @id @default(autoincrement())
  coverLetter  String
  bidAmount    Float
  deliveryTime Int
  status       ProposalStatus @default(PENDING)
  freelancerId Int
  jobId        Int

  freelancer User @relation(fields: [freelancerId], references: [id])
  job        Job  @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?

  @@unique([freelancerId, jobId])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Contract {
  id           Int            @id @default(autoincrement())
  proposalId   Int            @unique
  clientId     Int            @map("clinetId")
  freelancerId Int
  totalAmount  Float
  startDate    DateTime?
  status       ContractStatus @default(PENDING)

  proposal   Proposal @relation(fields: [proposalId], references: [id])
  client     User     @relation("ClientContracts", fields: [clientId], references: [id])
  freelancer User     @relation("FreelancerContracts", fields: [freelancerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Milestone {
  id         Int             @id @default(autoincrement())
  title      String
  amount     Float
  dueDate    DateTime
  status     MilestoneStatus @default(PENDING)
  contractId Int

  contract Contract @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  APPROVED
  PAID
}

model Payment {
  id          Int           @id @default(autoincrement())
  milestoneId Int           @unique
  amount      Float
  method      PaymentMethod @default(CHAPA)
  txRef       String?       @unique
  status      PaymentStatus @default(INITIATED)

  milestone Milestone @relation(fields: [milestoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  CHAPA
  TELEBIRR
}

enum PaymentStatus {
  INITIATED
  COMPLETED
  FAILED
}

// ========================================
// FREELANCER PROFILE
// ========================================

model FreelancerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  headline        String?
  bio             String?  @db.Text
  location        String?
  hourlyRate      Decimal? @db.Decimal(10, 2)
  profileImageUrl String?
  skills          String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  experiences    FreelancerExperience[]
  educations     FreelancerEducation[]
  certifications FreelancerCertification[]
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// FREELANCER EXPERIENCE
// ========================================

model FreelancerExperience {
  id                  Int       @id @default(autoincrement())
  freelancerProfileId Int
  jobTitle            String
  company             String
  location            String?
  description         String?   @db.Text
  startDate           DateTime?
  endDate             DateTime?
  isCurrent           Boolean   @default(false)

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

// ========================================
// FREELANCER EDUCATION
// ========================================

model FreelancerEducation {
  id                  Int       @id @default(autoincrement())
  freelancerProfileId Int
  institution         String
  degree              String?
  fieldOfStudy        String?
  startDate           DateTime?
  endDate             DateTime?
  description         String?   @db.Text

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

// ========================================
// FREELANCER CERTIFICATION
// ========================================

model FreelancerCertification {
  id                  Int       @id @default(autoincrement())
  freelancerProfileId Int
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

model PortfolioItem {
  id                  Int      @id @default(autoincrement())
  freelancerProfileId Int
  title               String
  description         String?  @db.Text
  projectUrl          String?
  imageUrl            String?
  technologies        String[] @default([])

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

model ClientProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  companyName     String?
  location        String?
  website         String?
  bio             String? @db.Text
  profileImageUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
