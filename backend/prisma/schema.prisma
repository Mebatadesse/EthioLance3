generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  googleId     String?  @unique
  firstName    String
  lastName     String
  phone        String?  @unique
  role         UserRole @default(FREELANCER)
  isVerified   Boolean  @default(false)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrationOtp RegistrationOtp?
  loginOtps       LoginOtp[]
  trustedDevices  TrustedDevice[]

  passwordResetToken PasswordResetToken?

  jobs      Job[]
  proposals Proposal[]

  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?

  contractAsClient     Contract[] @relation("ClientContracts")
  contractAsFreelancer Contract[] @relation("FreelancerContracts")
}

enum UserRole {
  FREELANCER
  CLIENT
  ADMIN
}



model Job {
  id           Int       @id @default(autoincrement())
  title        String
  description  String    @db.Text

  contractType JobContractType

  hourlyMinRate Float?
  hourlyMaxRate Float?
  fixedBudget   Float?

  deadline        DateTime
  requiredSkills  String[] @default([])
  attachments     String[] @default([])

  location        String?
  isRemote        Boolean @default(false)

  status      JobStatus @default(OPEN)

  clientId    Int
  client      User      @relation(fields: [clientId], references: [id])

  categoryId  Int
  category    JobCategory @relation(fields: [categoryId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposals   Proposal[]
}

model JobCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  jobs      Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobContractType {
  HOURLY
  FIXED_PRICE
}

model Proposal {
  id           Int            @id @default(autoincrement())
  coverLetter  String
  bidAmount    Float
  deliveryTime Int
  status       ProposalStatus @default(PENDING)
  freelancerId Int
  jobId        Int

  freelancer User @relation(fields: [freelancerId], references: [id])
  job        Job  @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?

  @@unique([freelancerId, jobId])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Contract {
  id           Int            @id @default(autoincrement())
  proposalId   Int            @unique
  clientId     Int            @map("clinetId")
  freelancerId Int
  totalAmount  Float
  startDate    DateTime?
  status       ContractStatus @default(PENDING)

  proposal   Proposal @relation(fields: [proposalId], references: [id])
  client     User     @relation("ClientContracts", fields: [clientId], references: [id])
  freelancer User     @relation("FreelancerContracts", fields: [freelancerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Milestone {
  id         Int             @id @default(autoincrement())
  title      String
  amount     Float
  dueDate    DateTime
  status     MilestoneStatus @default(PENDING)
  contractId Int

  contract Contract @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  APPROVED
  PAID
}

model Payment {
  id          Int           @id @default(autoincrement())
  milestoneId Int           @unique
  amount      Float
  method      PaymentMethod @default(CHAPA)
  txRef       String?       @unique
  status      PaymentStatus @default(INITIATED)

  milestone Milestone @relation(fields: [milestoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  CHAPA
  TELEBIRR
}

enum PaymentStatus {
  INITIATED
  COMPLETED
  FAILED
}

model FreelancerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  headline        String?
  bio             String?  @db.Text
  location        String?
  hourlyRate      Decimal? @db.Decimal(10, 2)
  profileImageUrl String?
  skills          String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  experiences    FreelancerExperience[]
  educations     FreelancerEducation[]
  certifications FreelancerCertification[]
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FreelancerExperience {
  id                  Int       @id @default(autoincrement())
  freelancerProfileId Int
  jobTitle            String
  company             String
  location            String?
  description         String?   @db.Text
  startDate           DateTime?
  endDate             DateTime?
  isCurrent           Boolean   @default(false)

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

model FreelancerEducation {
  id                  Int       @id @default(autoincrement())
  freelancerProfileId Int
  institution         String
  degree              String?
  fieldOfStudy        String?
  startDate           DateTime?
  endDate             DateTime?
  description         String?   @db.Text

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

model FreelancerCertification {
  id                  Int       @id @default(autoincrement())
  freelancerProfileId Int
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
  description         String?   @db.Text
  credentialId        String?
  certificateUrl      String?
  credentialUrl       String?

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

model PortfolioItem {
  id                  Int      @id @default(autoincrement())
  freelancerProfileId Int
  title               String
  description         String?  @db.Text
  projectUrl          String?
  fileUrl             String?
  technologies        String[] @default([])

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerProfileId])
}

model ClientProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  companyName     String?
  location        String?
  website         String?
  bio             String? @db.Text
  profileImageUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginOtp {
  id         Int       @id @default(autoincrement())
  userId     Int
  deviceId   String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
}

model TrustedDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceId   String
  deviceName String?
  trustedAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model RegistrationOtp {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
